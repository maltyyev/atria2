<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Atria.Tests</AssemblyName>
    <RootNamespace>Atria.Tests</RootNamespace>
  </PropertyGroup>
  <Import Project="../Assets/LocalizationResources.props" />
  <Import Project="../Assets/InterfaceResources.props" />
  <ItemGroup>
    <ProjectReference Include="../Src/Atria.Game.csproj" />
    <EmbeddedResource Include="../Src/Content/Atria2/OriginalNames.json" LogicalName="Atria.Tests.OriginalNames.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Video/Fixtures/*.framemd5" Link="VideoFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Video/Fixtures/*.audio.sha256" Link="VideoFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
