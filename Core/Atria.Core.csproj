<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Atria.Core</AssemblyName>
    <Version>0.17.7</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>Atria</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Src/**/*.cs" Exclude="../Src/Platform/Windows/**;../Src/bin/**;../Src/obj/**" />
    <EmbeddedResource Include="../Assets/Localization/ru-RU/*.json" LogicalName="Atria.Localization.Defaults.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Src/Content/Atria2/*.json" Exclude="../Src/Content/Atria2/OriginalNames.json" LogicalName="Atria.Content.Atria2.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
